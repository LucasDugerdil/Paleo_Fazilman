#### SSD / Height ####
Hist.diff <- MCWT.Faz.MP_ss_gf[[1]][c("TRY_SSD", "TRY_Height", "Age")]
Hist.diff$TRY_SSD <- scale(Hist.diff$TRY_SSD)
Hist.diff$TRY_Height <- scale(Hist.diff$TRY_Height)
Hist.diff$TRY_Resist_arid <- (Hist.diff$TRY_SSD - Hist.diff$TRY_Height) / ((Hist.diff$TRY_SSD + Hist.diff$TRY_Height) / 2)
Hist.diff$Drought <- "Wet"
Hist.diff$Drought[Hist.diff$Age > 150] <- "Dry"
Hist.diff$Drought[Hist.diff$Age > 500] <- "Wet"
Hist.diff$Drought[Hist.diff$Age > 3500] <- "Dry"
Hist.diff$Drought[Hist.diff$Age > 4500] <- "Wet"
Hist.diff$Drought[Hist.diff$Age > 8200] <- "Dry"
Hist.d <- ggplot(Hist.diff, aes(x = Age, y = TRY_Resist_arid))+geom_col(width = 70, position = "dodgev", na.rm = T, fill = "grey30")
Hist.d
