  P1R = 1}
  
  if(is.null(MatDiv) == F){P1L = 0
  if(length(MatDiv[,1]) == 1){P1R = 0.86}
  else{P1R = (1 - 0.07*length(MatDiv[,1]))}
  P2L = P1R
  P2R = 1}
  
