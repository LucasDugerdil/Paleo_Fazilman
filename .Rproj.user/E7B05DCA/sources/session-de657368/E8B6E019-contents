    plot.margin = unit(c(0,0,0,0), "lines")
  )
  
  #### Grob ####
  if(length(which(c(is.null(XRF), is.null(MS), is.null(GDGT), is.null(Isotope)) == F)) > 1){
    z <- ggplot2::ggplotGrob(p1)
