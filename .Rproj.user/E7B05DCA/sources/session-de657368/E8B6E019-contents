        New_Q3 <- My_arrows[i,"Q1"]
        My_arrows[i,"Q1"] <- New_Q1
        My_arrows[i,"Q3"] <- New_Q3
      }
    }
    My_arrows$Arrow.y <- Arrow.y
    My_Plab <- geom_text(data = My_arrows, inherit.aes = F,
                         aes(x = Mil,
                             y = (x + 1.5*Arrow.y*x),
                             label = Label.proxy#,
                             # color = Categorie
                         )
    )
    
    My_arrows.draw <- geom_segment(data = My_arrows, inherit.aes = F,
                                   aes(x = Q1,
                                       y = x,
